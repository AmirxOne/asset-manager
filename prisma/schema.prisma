// Asset Management System — Prisma Schema
// Phase 1: Identity & RBAC · Phase 2: Asset core

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ Identity & RBAC ============================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?   @unique
  fullName     String
  passwordHash String
  avatarUrl    String?
  jobTitle     String?
  isActive     Boolean   @default(true)
  isSuperAdmin Boolean   @default(false)
  employeeId   String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee  Employee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  roles     UserRole[]
  sessions  Session[]
  auditLogs AuditLog[]
  assetsCreated Asset[] @relation("AssetCreator")
  assetEvents   AssetEvent[] @relation("AssetEventActor")
  assignmentsMade Assignment[] @relation("AssignmentAssigner")
  assignmentsReturned Assignment[] @relation("AssignmentReturner")

  @@index([isActive])
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique
  name  String
  group String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id          String   @id @default(cuid())
  identifier  String
  ip          String?
  success     Boolean  @default(false)
  attemptedAt DateTime @default(now())

  @@index([identifier, attemptedAt])
  @@index([ip, attemptedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
}

// ============================ Org (Phase 3) ============================

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[] @relation("EmployeeDepartment")
  assetDepartment Asset[] @relation("AssetDepartment")

  @@index([isActive])
}

model Location {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  /// BUILDING | FLOOR | ROOM | WAREHOUSE | BRANCH
  type      String   @default("ROOM")
  parentId  String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Location[] @relation("LocationTree")
  assets   Asset[]

  @@index([parentId])
  @@index([type])
}

model Employee {
  id            String    @id @default(cuid())
  fullName      String
  personnelCode String    @unique
  departmentId  String?
  position      String?
  managerId     String?
  email         String?
  phone         String?
  status        String    @default("ACTIVE")
  hireDate      DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  department Department?      @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  manager    Employee?        @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports    Employee[]       @relation("EmployeeManager")
  user       User?
  heldAssets Asset[]          @relation("AssetHolder")
  assignments Assignment[]
}

// ============================ Asset core (Phase 2) ============================

model AssetCategory {
  id                   String   @id @default(cuid())
  name                 String
  /// کد سه‌حرفی در کد دارایی — مثل IT / NET / FUR
  code                 String   @unique
  parentId             String?
  description          String?
  defaultWarrantyMonths Int?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  parent AssetCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children AssetCategory[] @relation("CategoryTree")
  types   AssetType[]

  @@index([parentId])
}

model AssetType {
  id          String   @id @default(cuid())
  name        String
  /// کد سه‌حرفی نوع — مثل MOU / MON / LAP / SRV
  code        String   @unique
  categoryId  String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assets   Asset[]

  @@index([categoryId])
}

model Asset {
  id                String    @id @default(cuid())
  code              String    @unique
  name              String
  assetTypeId       String
  brand             String?
  model             String?
  serialNumber      String?   @unique
  purchaseDate      DateTime?
  purchasePrice     Decimal?  @db.Decimal(14, 2)
  currency          String    @default("IRR")
  supplierId        String?
  warrantyStart     DateTime?
  warrantyEnd       DateTime?
  locationId        String?
  departmentId      String?
  holderEmployeeId  String?
  status            String    @default("IN_STOCK")
  condition         String    @default("GOOD")
  lifecycleStage    String    @default("IN_STOCK")
  notes             String?
  qrGeneratedAt     DateTime?
  isDeleted         Boolean   @default(false)
  retiredAt         DateTime?
  disposedAt        DateTime?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  assetType AssetType     @relation(fields: [assetTypeId], references: [id], onDelete: Restrict)
  createdBy User?         @relation("AssetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  events    AssetEvent[]
  holder    Employee?     @relation("AssetHolder", fields: [holderEmployeeId], references: [id], onDelete: SetNull)
  assignments Assignment[]
  location  Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  department Department?  @relation("AssetDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([status, assetTypeId])
  @@index([holderEmployeeId])
  @@index([locationId])
  @@index([departmentId])
  @@index([supplierId])
  @@index([warrantyEnd])
  @@index([isDeleted, status])
}

model AssetEvent {
  id             String   @id @default(cuid())
  assetId        String
  type           String
  fromStatus     String?
  toStatus       String?
  fromEmployeeId String?
  toEmployeeId   String?
  fromLocationId String?
  toLocationId   String?
  actorId        String?
  metadata       Json?
  note           String?
  occurredAt     DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  actor User? @relation("AssetEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([assetId, occurredAt])
}

/// شمارنده اتمیک پیشوندهای کد دارایی — increment با تراکنش
model CodeSequence {
  prefix String @id
  seq    BigInt @default(0)
}

model Settings {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ============================ Assignment (Phase 3) ============================

/// هر تحویل/عودت/انتقال = رکورد با تاریخچه کامل
model Assignment {
  id                String    @id @default(cuid())
  assetId           String
  employeeId        String
  assignedById      String?
  assignedAt        DateTime  @default(now())
  dueAt             DateTime?
  returnedAt        DateTime?
  returnedById      String?
  status            String    @default("ACTIVE") // ACTIVE | RETURNED
  conditionAtAssign String?
  conditionAtReturn String?
  assignNote        String?
  returnNote        String?

  asset        Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedBy   User?         @relation("AssignmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  returnedBy   User?         @relation("AssignmentReturner", fields: [returnedById], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([assetId, status])
  @@index([assignedAt])
}
